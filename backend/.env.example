PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/convo

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=180d
CLIENT_URL=http://localhost:5173
# Comma-separated account emails allowed to view the admin dashboard.
ADMIN_EMAILS=admin@example.com

# Brevo password reset emails (use a sender address verified in Brevo).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Convo

# Brevo password reset emails (use a sender address verified in Brevo).

# Brevo password reset emails (verify this sender address in Brevo).

# Optional Cloudflare Realtime TURN relay credentials for audio calls.
# Keep the API token only in the backend environment (for example, Render).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key







VOICE_MAX_DURATION_SECONDS=300
VOICE_MAX_FILE_SIZE_MB=15
